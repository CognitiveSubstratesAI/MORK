;; Self-contained lte-generation fixture (bound 6), derived from Nil Geisweiller's
;; gen-lte.mm2 (ngeiswei/chaining@mork-bfc). fromNumber facts inlined; ACT load/store
;; dropped — the recursion-termination behaviour lives entirely in the lte-generation
;; rules (self-respawning exec + O-sink `(-)` front retirement).
;;
;; ORACLE (upstream `target/release/mork run --timing`): halts at 58 steps.
;; ✅ OURS HALTS AT 58 TOO — Δ=0, re-measured 2026-08-12 via workflows/mm2_xcheck.sh.
;;
;; ⚠️ THIS HEADER PREVIOUSLY SAID "our MORK currently does NOT halt (exec-resurrection regression,
;; Space.jl _pat_overlaps_exec_prefix / pjoin path)". THAT DIAGNOSIS WAS WRONG AND THE CLAIM IS STALE.
;; It was never exec-resurrection: the NAIVE multi-source join was exploding (~step 10), fixed by
;; flipping the default to coref in `921c05c`. `test/integration/upstream_conformance.jl:132-133`
;; recorded the correction; this file did not, so the wrong diagnosis kept propagating out of here —
;; into `docs/specs/omegaclaw/omegaclaw_study_findings_2026-07-16.md` §1(f), and from there into a
;; fresh summary on 2026-08-12 that repeated "even a correctly-written self-respawning driver is not
;; trustworthy here". It is trustworthy; this fixture proves it.
;;
;; STILL THE REGRESSION DETECTOR, and now a passing one: wired at upstream_conformance.jl:136
;; (`_ours_default(lte, 200) == _upstream(lte, 200)`) and runnable ad hoc via workflows/mm2_xcheck.sh.

(= (fromNumber 0) Z)
(= (fromNumber 1) (S Z))
(= (fromNumber 2) (S (S Z)))
(= (fromNumber 3) (S (S (S Z))))
(= (fromNumber 4) (S (S (S (S Z)))))
(= (fromNumber 5) (S (S (S (S (S Z))))))
(= (fromNumber 6) (S (S (S (S (S (S Z)))))))

(NumBound 6)

(exec Init
      (, (NumBound $n)
         (= (fromNumber $n) $b))
      (, (: Z BndNat)
         (exec (0 $b)
               (, (: $k BndNat)
                  (exec (0 (S $l)) $pat $tmp))
               (, (: (S $k) BndNat)
                  (exec (0 $l) $pat $tmp)))
         (cf1 (lte Z Z))
         (cf2 (lte Z Z))
         (lte Z Z)
         (exec (1 $b $b t)
               (, (cf1 (lte $x $y))
                  (: (S $x) BndNat)
                  (: (S $y) BndNat)
                  (exec (1 (S $k) (S $l) t) $pat $tmp))
               (O (+ (lte (S $x) (S $y)))
                  (+ (cf1 (lte (S $x) (S $y))))
                  (+ (cf2 (lte (S $x) (S $y))))
                  (+ (exec (1 $k $l t) $pat $tmp))
                  (- (cf1 (lte $x $y)))))
         (exec (1 $b $b t)
               (, (cf2 (lte $x $y))
                  (: $x BndNat)
                  (: (S $y) BndNat)
                  (exec (1 $k (S $l) t) $pat $tmp))
               (O (+ (lte $x (S $y)))
                  (+ (cf1 (lte $x (S $y))))
                  (+ (cf2 (lte $x (S $y))))
                  (+ (exec (1 $k $l t) $pat $tmp))
                  (- (cf2 (lte $x $y)))))))
