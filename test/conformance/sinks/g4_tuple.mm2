; g4 symbol/expr ops: explode/collapse/tuple nesting + collapse on a bare symbol
(w abc)
(exec 0 (, (w $x))
  (O (pure (ex $r) $r (explode_symbol $x)))
)
(exec 0 (, (w $x))
  (O (pure (co $r) $r (collapse_symbol (explode_symbol $x))))
)
(exec 0 (, (w $x))
  (O (pure (tu $r) $r (tuple $x $x)))
)
(exec 0 (, (w $x))
  (O (pure (tn $r) $r (tuple (explode_symbol $x) $x)))
)
(exec 0 (, (w $x))
  (O (pure (cs $r) $r (collapse_symbol $x)))
)
