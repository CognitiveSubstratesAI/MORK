; g4 ops that exist ONLY in our port (upstream: unknown function => eval Err => drop)
(n 1)
(exec 0 (, (n $x))
  (O (pure (fadd $r) $r (f64_to_string (f64_add (f64_from_string 1.0) (f64_from_string 2.0)))))
)
(exec 0 (, (n $x))
  (O (pure (uparse $r) $r (i64_to_string (i64_from_string 5))))
)
(exec 0 (, (n $x))
  (O (pure (u32str $r) $r (u32_to_string (u32_from_string 9))))
)
(exec 0 (, (n $x))
  (O (pure (nth $r) $r (nth_expr (i64_from_string 0) (i64_from_string 3))))
)
