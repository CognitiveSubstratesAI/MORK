; g4 op ARITY checking: upstream consume_head_check enforces exact arity, ours ignores extras
(n 1)
(exec 0 (, (n $x))
  (O (pure (extra $r) $r (i64_to_string (i64_from_string 3) (i64_from_string 4))))
)
(exec 0 (, (n $x))
  (O (pure (zeroary $r) $r (i64_to_string (sum_i64))))
)
(exec 0 (, (n $x))
  (O (pure (onearg $r) $r (i64_to_string (sum_i64 (i64_from_string 9)))))
)
(exec 0 (, (n $x))
  (O (pure (binextra $r) $r (i64_to_string (sub_i64 (i64_from_string 9) (i64_from_string 4) (i64_from_string 2)))))
)
