; g4 comparison family (lt/lte/gt/gte/eq/ne) — 42 ops registered upstream
(p 3 5)
(exec 0 (, (p $x $y))
  (O (pure (lt $r) $r (i8_to_string (lt_i64 (i64_from_string $x) (i64_from_string $y)))))
)
(exec 0 (, (p $x $y))
  (O (pure (gte $r) $r (i8_to_string (gte_i64 (i64_from_string $x) (i64_from_string $y)))))
)
(exec 0 (, (p $x $y))
  (O (pure (eqf $r) $r (i8_to_string (eq_f64 (f64_from_string 1.5) (f64_from_string 1.5)))))
)
(exec 0 (, (p $x $y))
  (O (pure (ne $r) $r (i8_to_string (ne_i32 (i32_from_string $x) (i32_from_string $y)))))
)
