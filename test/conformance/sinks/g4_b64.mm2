; g4 base64: upstream uses URL_SAFE_NO_PAD (no '=', '-_' alphabet)
(w abcd)
(exec 0 (, (w $x))
  (O (pure (pad $r) $r (encode_base64url $x)))
)
(exec 0 (, (w $x))
  (O (pure (alph $r) $r (encode_base64url (decode_hex fbff))))
)
(exec 0 (, (w $x))
  (O (pure (rt $r) $r (encode_hex (decode_base64url (encode_base64url (decode_hex fbff))))))
)
