#!/usr/bin/env bash
# pre-commit hook — block hardcoded local paths and the committer's own email.
#
# No hardcoded usernames/emails live in THIS file (it's a public repo):
#   1. a generic /home|/Users/<user> path is blocked in CODE files (docs may
#      legitimately show example placeholders like /home/username/);
#   2. the committer's ACTUAL home dir ($HOME) is blocked everywhere — derived
#      at runtime, so it catches real paths in docs too without flagging
#      placeholders, and nothing personal is stored here;
#   3. the committer's `git config user.email` is blocked everywhere — also
#      derived at runtime.
#
# Install: git config core.hooksPath .githooks
set -euo pipefail

CODE_EXT="\.(jl|toml|yml|yaml|sh|py|json)$"          # path regex: code only
ALL_EXT="\.(jl|toml|md|yml|yaml|sh|py|json|txt)$"    # $HOME / email: all source

staged() { git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true; }

EXIT=0
report() {  # $1 = label, $2 = matching files
    echo ""
    echo "❌  COMMIT BLOCKED — $1"
    echo "    Found in:"; echo "$2" | sed 's/^/      /'
    echo "    Use ~, \$HOME, @__DIR__, or env vars instead.  Bypass: git commit --no-verify"
    EXIT=1
}

CODE=$(staged "$CODE_EXT")
ALL=$(staged "$ALL_EXT")

# 1. generic hardcoded home path in code (no username hardcoded here)
if [[ -n "$CODE" ]]; then
    h=$(echo "$CODE" | xargs grep -lE '(/home|/Users)/[A-Za-z0-9._-]+' 2>/dev/null || true)
    [[ -n "$h" ]] && report "hardcoded local home path in code" "$h"
fi

# 2. the committer's actual home dir, anywhere (runtime $HOME, not stored here)
if [[ -n "${HOME:-}" && "$HOME" == /* && "$HOME" != "/" && -n "$ALL" ]]; then
    h=$(echo "$ALL" | xargs grep -lF "$HOME" 2>/dev/null || true)
    [[ -n "$h" ]] && report "your home dir ('$HOME') in source" "$h"
fi

# 3. the committer's email, anywhere (runtime git config, not stored here)
EMAIL=$(git config user.email 2>/dev/null || true)
if [[ -n "$EMAIL" && -n "$ALL" ]]; then
    h=$(echo "$ALL" | xargs grep -lF "$EMAIL" 2>/dev/null || true)
    [[ -n "$h" ]] && report "your git email ('$EMAIL') in source" "$h"
fi

exit $EXIT
