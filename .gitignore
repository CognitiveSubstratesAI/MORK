# Claude Code local settings — not for public repos
.claude/

# ⚠️  NEVER commit files containing hardcoded local paths such as:
#     /home/<username>/...   /Users/<username>/...   user@email.com
# A pre-commit hook enforces this automatically.
# Install: git config core.hooksPath .githooks

# Julia build artifacts
*.jl.cov
*.jl.mem
*.orig
*.ji

# Julia package manager
/Manifest.toml.bak

# Julia precompile cache (never commit)
# (already excluded by Julia's .gitignore conventions)

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# Runtime artifacts generated by MORK server / ACTSink / benchmarks
/tmp/
*.act
*.log
nohup.out
*.pid
*.lock
mork_server.log

# Benchmark outputs (generated by viz_benchmarks.jl)
*.csv
# …except the ONE tracked-alongside reference. `examples/bfc/reference/` has its generator
# (`regular-vs-emulated-petta-benchmark.sh`), the four `.gnuplot` scripts that CONSUME this file,
# the four plots RENDERED from it, and `examples/bfc/README.md:120` LINKS to it — all tracked. The
# CSV was the only untracked file in its own directory, so a clone got a broken README link and a
# plot pipeline with no input.
!examples/bfc/reference/regular-vs-emulated-petta-benchmark.csv
benchmark_results/
bench_output/

# Test coverage
/lcov.info
coverage/

# Environment / secrets (never commit)
.env
.env.*
*.key
*.pem
*.cert
*.p12
secrets.toml

# Transient runtime artifacts (resource-store / exec dumps, hash-named) +
# local dev REPL harness — never part of the published kernel.
0000*-0000000000000000-*
# 🔴 `repl/` HELD THE DEV SERVER ITSELF, NOT JUST ITS RUNTIME (fixed 2026-09-02). The blanket
# directory rule hid `repl/client.sh` AND `repl/server.jl` — and CLAUDE.md documents
# `MORK/repl/client.sh start|status|eval-jl|test` as a live tool, so a fresh clone could not run
# what the docs instruct. Same failure as the libswipl spike: no commit CAN mention a path nothing
# tracks. Excluding the CONTENTS (`repl/*`) rather than the DIRECTORY lets the two sources be
# negated back in; git will not descend into an excluded directory, so `repl/` + `!repl/client.sh`
# would not have worked.
repl/*
!repl/client.sh
!repl/server.jl
server.log
server.pid
docs/build/
docs/Manifest.toml
examples/bfc/.rust_run/

# local suite verdict written by tools/run_tests.sh; see tools/suite_result.sh
tools/.last_suite_result
