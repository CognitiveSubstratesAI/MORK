# Claude Code local settings — not for public repos
.claude/

# ⚠️  NEVER commit files containing hardcoded local paths such as:
#     /home/<username>/...   /Users/<username>/...   user@email.com
# A pre-commit hook enforces this automatically.
# Install: git config core.hooksPath .githooks

# Julia build artifacts
*.jl.cov
*.jl.mem
*.orig
*.ji

# Julia package manager
/Manifest.toml.bak

# Julia precompile cache (never commit)
# (already excluded by Julia's .gitignore conventions)

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/
*.iml

# Runtime artifacts generated by MORK server / ACTSink / benchmarks
/tmp/
*.act
*.log
nohup.out
*.pid
*.lock
mork_server.log

# Benchmark outputs (generated by viz_benchmarks.jl)
*.csv
benchmark_results/
bench_output/

# Test coverage
/lcov.info
coverage/

# Environment / secrets (never commit)
.env
.env.*
*.key
*.pem
*.cert
*.p12
secrets.toml

# Transient runtime artifacts (resource-store / exec dumps, hash-named) +
# local dev REPL harness — never part of the published kernel.
0000*-0000000000000000-*
repl/
server.log
server.pid
docs/build/
docs/Manifest.toml
examples/bfc/.rust_run/
